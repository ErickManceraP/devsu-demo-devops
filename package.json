{
  "name": "demo",
  "version": "1.0.0",
  "description": "Devsu DevOps Demo - Node.js",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js"
  },
  "jest": {
    "transform": {
      "^.+\\.js?$": "babel-jest"
    },
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!babel.config.js",
      "!jest.config.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 50
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "author": "Devsu",
  "dependencies": {
    "dotenv": "16.0.3",
    "express": "4.18.2",
    "sequelize": "6.31.0",
    "sqlite3": "5.1.6",
    "yup": "1.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "7.21.4",
    "@types/express": "4.17.17",
    "babel-jest": "29.5.0",
    "eslint": "8.40.0",
    "jest": "29.5.0",
    "supertest": "6.3.3"
  }
}
